///|
pub fn port_risk_tag(port : Int) -> String {
  match port {
    21 => "review-exposure"
    23 => "review-exposure"
    25 => "review-exposure"
    110 => "review-exposure"
    139 => "review-exposure"
    445 => "review-exposure"
    1433 => "review-exposure"
    3306 => "review-exposure"
    3389 => "review-exposure"
    5432 => "review-exposure"
    6379 => "review-exposure"
    9200 => "review-exposure"
    11211 => "review-exposure"
    27017 => "review-exposure"
    22 => "expected-service"
    80 => "expected-service"
    443 => "expected-service"
    853 => "expected-service"
    993 => "expected-service"
    995 => "expected-service"
    1883 => "expected-service"
    5672 => "expected-service"
    6443 => "expected-service"
    8443 => "expected-service"
    _ => if port >= 49152 { "ephemeral" } else { "ordinary" }
  }
}
